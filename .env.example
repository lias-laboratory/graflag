# GraFlag configuration -- copy to ~/.config/graflag/config.env and edit,
# or let `graflag setup` write it for you.
#
# This file is named .env.example, not .env, on purpose. get_config_path()
# prefers a `.env` in the working directory over the user config whenever it
# defines MANAGER_IP, so a `.env` committed at the repo root would silently
# become the config for every command run from here -- pointing at whichever
# manager and SSH key happened to be current when it was committed.

# Manager connection (MANAGER_IP is the only required key)
MANAGER_IP=192.168.1.100
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519

# Shared NFS storage exported by the manager
SHARED_DIR=/shared
NFS_PORT=2049

# hosts.yml is read only by `graflag setup` and `graflag devcluster`
HOSTS_FILE=hosts.yml

# Where method images get graflag_runner and graflag_bond: local | pypi
GRAFLAG_LIBS=local
